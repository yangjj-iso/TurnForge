# Export these variables in the shell that starts the service. Spring does not load this file.
REDY_HOST=127.0.0.1
REDY_PORT=8080
REDY_DATA_DIR=.redy-data
# Set both to use a real OpenAI-compatible provider instead of the offline demo.
# REDY_MODEL_BASE_URL=https://your-provider.example/v1
# REDY_MODEL_API_KEY=your-key
# REDY_MODEL_REQUEST_TIMEOUT=60s
# Spring relaxed binding for redy.runtime.*:
REDY_RUNTIME_MAXSTEPS=8
REDY_RUNTIME_MAXCONCURRENTTURNS=16
REDY_RUNTIME_MAXQUEUEDTURNS=64
REDY_RUNTIME_TURNTIMEOUT=5m
REDY_RUNTIME_MAXSUBSCRIBERS=64
